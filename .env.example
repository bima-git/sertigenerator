APP_NAME="Generator Sertifikat XCODE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Konfigurasi Database (Gunakan SQLite untuk dev cepat atau MySQL/MariaDB untuk produksi)
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sertigenerator
# DB_USERNAME=root
# DB_PASSWORD=

# Konfigurasi Sesi (8 jam / 480 menit sesuai PRD AU-03)
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Konfigurasi Akun Administrator Awal (Wajib diganti sebelum menjalankan AdminUserSeeder)
# PENTING: Ganti dengan kata sandi kuat dan unik. Jangan gunakan nilai default di server nyata!
ADMIN_USERNAME=admin
ADMIN_NAMA="Administrator XCODE"
ADMIN_PASSWORD="GANTI_DENGAN_PASSWORD_ADMIN_YANG_KUAT_DAN_UNIK_123!"

# Konfigurasi Penerbitan Sertifikat & QR (PRD 4.5 & Design System 1.5)
QR_MODE=fixed
QR_URL=https://xcode.co.id/cekkodesertifikat
KOTA_TERBIT=Yogyakarta

VITE_APP_NAME="${APP_NAME}"
